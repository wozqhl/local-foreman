# Copy to .env and fill in. Never commit real keys.
LOCAL_FOREMAN_WORKER=mlx
LOCAL_FOREMAN_COACH=openai
LOCAL_FOREMAN_MLX_MODEL=mlx-community/Qwen3-8B-4bit
COACH_BASE_URL=https://api.openai.com/v1
COACH_API_KEY=
COACH_MODEL=gpt-4o

# Persistent agency (optional). One-shot CLI stays task-driven unless this is 1.
# `local-foreman ui` turns persist+idle on by itself.
LOCAL_FOREMAN_PERSIST=0
# LOCAL_FOREMAN_TRAJ=.local-foreman/traj.jsonl
# LOCAL_FOREMAN_IDLE_START=5
# LOCAL_FOREMAN_IDLE_CAP=300
# Optional: dollars per coach ask. Unset = count only, no estimated USD.
# COACH_USD_PER_ASK=
# Optional: hard cap on asked_coach. Unset = no cap.
# LOCAL_FOREMAN_MAX_ASKS=
# Optional: hard cap on verified_coach. Unset = no cap.
# LOCAL_FOREMAN_MAX_VERIFIES=
# Optional: unused as a sole gate. Router is tool kind (read=local, write=verify).
# LOCAL_FOREMAN_VERIFY_BELOW=0.55
